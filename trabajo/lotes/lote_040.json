[
{
"id": 10320,
"en": "I got the three toxic mushrooms for that guy from Tsukimino. Medicine's an odd thing.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10321,
"en": "Looks like I passed Okudera-han's test. Gotta keep learnin', though.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10322,
"en": "Turns out there was no wild snowman. It's fun to dream, I guess.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10323,
"en": "Got the bear fat to the woman with bad skin. Marriage, huh?",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10324,
"en": "Rescued the trapper from his own trap. Can never be too careful, I guess.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10325,
"en": "Found a bear skin for that ramen guy. That order sounded like a magic spell.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10326,
"en": "Sold a marten pelt to the trader.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10327,
"en": "Sold a fox skin to the trader.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10328,
"en": "Sold deer meat to the trader.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10329,
"en": "Sold a whole deer to the trader.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
"id": 10330,
"en": "Sold a whole bear to the trader. Normal folks should steer clear of yakuza.",
"ctx": "tabla yukiyama_menu_mission|EXPLANATION_END"
},
{
