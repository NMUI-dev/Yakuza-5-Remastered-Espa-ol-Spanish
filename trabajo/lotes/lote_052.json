"en": "I ain't dyin' here... I can't!",
"ctx": "subtítulo de escena B2220"
},
{
"id": 14838,
"en": "This is the place.",
"ctx": "subtítulo de escena B2280 + subtítulo de escena C3320 …"
},
{
"id": 14839,
"en": "Surprised ya remembered where it was.",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14840,
"en": "Please. Nice and clean for you.",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14841,
"en": "Found it!",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14842,
"en": "The Macallan 1946.",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14843,
"en": "Just a second.",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14844,
"en": "Damn, that's good!",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14845,
"en": "Real good.",
"ctx": "subtítulo de escena B2280"
},
{
"id": 14846,
"en": "Kitakata, sir.",
"ctx": "subtítulo de escena B2300"
},
{
"id": 14847,
"en": "Please stay vigilant, sir.",
"ctx": "subtítulo de escena B2300"
},
{
"id": 14848,
"en": "Hm? Is there a problem?",
