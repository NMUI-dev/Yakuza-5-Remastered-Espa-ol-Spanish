{
"id": 7593,
"en": "Haha, oh really?",
"ctx": "menú/texto string_tbl"
},
{
"id": 7594,
"en": "Oh, um... I'm not really sure.",
"ctx": "menú/texto string_tbl + diálogo uid016900b1"
},
{
"id": 7595,
"en": "That's not true.",
"ctx": "menú/texto string_tbl + diálogo uid01340012 …"
},
{
"id": 7596,
"en": "Oh, really?",
"ctx": "menú/texto string_tbl + diálogo uid00330532 …"
},
{
"id": 7597,
"en": "I'm serious.",
"ctx": "menú/texto string_tbl"
},
{
"id": 7598,
"en": "I feel the same about you!",
"ctx": "menú/texto string_tbl"
},
{
"id": 7599,
"en": "I'm giving it my all!",
"ctx": "menú/texto string_tbl"
},
{
"id": 7600,
"en": "I'm so glad to see you!",
